# =====================================================================
# NeoBank Digital Banking Platform - Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In PRODUCTION, all secrets MUST be replaced with cryptographically secure values.

# ---------------------------------------------------------------------
# 1. Environment Mode
# ---------------------------------------------------------------------
# Values: development | staging | production
ENVIRONMENT=development

# ---------------------------------------------------------------------
# 2. Server Network Configuration
# ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------------
# 3. Cryptographic Keys & Secrets (MANDATORY IN ALL ENVIRONMENTS)
# ---------------------------------------------------------------------
# Generate a random 64-char hex secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Generate a valid Fernet AES-256 key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation, supply versioned keys as comma-separated: NEW_PRIMARY_KEY,OLD_KEY_1
NEOBANK_DOC_KEY=

# Secret key required for POS terminal card authorization transactions
# Generate a random 32-char secret: python -c "import secrets; print(secrets.token_urlsafe(24))"
POS_GATEWAY_KEY=

# ---------------------------------------------------------------------
# 4. Session & Security Token Lifespans
# ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security Configuration (Production requires COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------
# 5. Network Allowlist & Reverse Proxies
# ---------------------------------------------------------------------
# CORS: Comma-separated list of allowed origins (leave empty in production to require explicit domains)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# Trusted reverse proxies for client IP resolution (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# ---------------------------------------------------------------------
# 6. Seed / Demo Initial Data (Local Sandbox Only)
# ---------------------------------------------------------------------
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_EMAIL=employee@example.local
SEED_EMPLOYEE_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.local
SEED_CUSTOMER_PASSWORD=
SEED_CARD_PIN=
SEED_CARD_ACTIVATION_CODE=

# ---------------------------------------------------------------------
# 7. Business & Operational Parameters
# ---------------------------------------------------------------------
OTP_THRESHOLD=1000.0
TRANSFER_EXTERNAL_FEE=1.50
BASE_LOAN_APR=6.0
MAX_DOC_SIZE_BYTES=10485760

# ---------------------------------------------------------------------
# 8. External Database Bridges (Optional)
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=neobank

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neobank_app
MYSQL_PASSWORD=
MYSQL_DB=neobank
