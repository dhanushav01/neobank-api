# =====================================================================
# NeoBank Digital Banking Platform - Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In PRODUCTION, all secrets MUST be replaced with real, cryptographically secure values.
# The server will FAIL TO START in production if any required secret contains a CHANGE_ME placeholder.

# ---------------------------------------------------------------------
# 1. Environment & Server Binding
# ---------------------------------------------------------------------
# Values: development | staging | production | test
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
# PORT is used by cloud container environments (Render, Cloud Run)
PORT=8000

# ---------------------------------------------------------------------
# 2. Cryptographic Keys & Secrets (MANDATORY IN PRODUCTION)
# ---------------------------------------------------------------------
# Generate a random 64-char hex secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME

# Fernet (AES-128-CBC + HMAC-SHA256) key for encrypted document vault.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation, supply versioned keys as comma-separated: NEW_PRIMARY_KEY,OLD_KEY_1
NEOBANK_DOC_KEY=CHANGE_ME

# Secret key required for POS terminal card authorization transactions (X-Gateway-Key header)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
POS_GATEWAY_KEY=CHANGE_ME

# ---------------------------------------------------------------------
# 3. Safe First-Admin Bootstrap (Production Setup)
# ---------------------------------------------------------------------
# If set on startup and no admin exists, provisions initial administrator.
# Requires: min 12 chars, uppercase, lowercase, digit, symbol.
ADMIN_EMAIL=bootstrap.admin@example.local
ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# 4. Database Persistence & Path
# ---------------------------------------------------------------------
# Custom SQLite database path. For Render persistent disk, set: /data/neobank.db
NEOBANK_DB_PATH=/data/neobank.db

# ---------------------------------------------------------------------
# 5. Security Flags & Testing Diagnostic Routes
# ---------------------------------------------------------------------
# Set to 'true' ONLY in sandbox environments to seed demo accounts on fresh DB
SEED_DEMO_USERS=false

# Diagnostic routes (/delay, /flaky, /rate-limit). Strictly false in production.
ENABLE_TEST_ROUTES=false

# SlowAPI rate limiting engine (default: true)
ENABLE_RATE_LIMIT=true

# ---------------------------------------------------------------------
# 6. Session & Cookie Policy
# ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# In production (ENVIRONMENT=production), COOKIE_SECURE automatically evaluates to true
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ---------------------------------------------------------------------
# 7. CORS Origins & Reverse Proxies
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Leave empty in production to require explicit domains.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Trusted reverse proxies for client IP rate limiting (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# ---------------------------------------------------------------------
# 8. Business Parameters & OTP Delivery
# ---------------------------------------------------------------------
OTP_THRESHOLD=1000.0
# OTP Delivery mechanism: "notification" (in-app demo feed), "console" (server logs), "none"
# WARNING: "notification" is strictly for demo/sandbox convenience and not a real out-of-band second factor.
OTP_DELIVERY=notification
TRANSFER_EXTERNAL_FEE=1.50
BASE_LOAN_APR=6.0
MAX_DOC_SIZE_BYTES=10485760

# ---------------------------------------------------------------------
# 9. External Database Bridges (Optional - for SQL GUI sync)
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=neobank

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=neobank_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=neobank

# ---------------------------------------------------------------------
# 10. Demo Seeding Overrides (Only used when SEED_DEMO_USERS=true)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@bank.test
SEED_ADMIN_PASSWORD=Admin@1234
SEED_EMPLOYEE_EMAIL=employee@bank.test
SEED_EMPLOYEE_PASSWORD=Employee@1234
SEED_CUSTOMER_EMAIL=customer@bank.test
SEED_CUSTOMER_PASSWORD=Customer@1234
SEED_CARD_PIN=1234
SEED_CARD_ACTIVATION_CODE=849201
